# --- Emergent workspace artifacts (do NOT publish to GitHub) ---
# These directories/files are managed by the Emergent platform and are
# NOT part of the Electron application. They may be recreated at any
# time by supervisor/watchers; keep them out of the pushed repository
# so `git clone && npm install && npm run build && npm run dist:portable`
# stays a clean, standalone Electron project.
.emergent/
frontend/
backend/
tests/
memory/
test_reports/
test_result.md
.ruff_cache/
